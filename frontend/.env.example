# Frontend environment (Next.js). Copy to `.env.local` (git-ignored) and fill in.
# All client-side vars MUST be prefixed NEXT_PUBLIC_ — they are inlined into the
# bundle at build time. Every var below is OPTIONAL; if unset the app falls back to
# the public defaults hard-coded in src/components/providers.tsx.

# Dedicated / paid RPC endpoints (recommended for production — the public defaults
# are rate-limited and cap eth_getLogs to ~10k blocks).
NEXT_PUBLIC_UNICHAIN_RPC_URL=https://mainnet.unichain.org
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Use your OWN project id for production instead of the shared demo one.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
